---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentSection from '../../components/CommentSection';
import { serverFetch } from '../../lib/api';
import { canEditPost } from '../../lib/permissions';
import { formatDate, calculateReadingTime } from '../../lib/utils';
import { codeToHtml } from 'shiki';

const { slug } = Astro.params;
const cookie = Astro.request.headers.get('cookie') || '';

const res = await serverFetch(`/posts/${slug}`, cookie);
if (!res.ok) {
  return new Response(null, { status: 404 });
}

const post = await res.json();
const readingTime = calculateReadingTime(post.body);

// Get current user for comment section
let user = null;
try {
  const authRes = await serverFetch('/auth/me', cookie);
  if (authRes.ok) {
    user = await authRes.json();
  }
} catch {}

const canEdit = canEditPost(user, post.author_id);

// Process code blocks with Shiki for syntax highlighting
let processedBody = post.body;
const codeBlockRegex = /<pre><code(?:\s+class="language-(\w+)")?>([\s\S]*?)<\/code><\/pre>/g;
const matches = [...processedBody.matchAll(codeBlockRegex)];

for (const match of matches) {
  const lang = match[1] || 'text';
  const code = match[2]
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");

  try {
    const highlighted = await codeToHtml(code, {
      lang,
      theme: 'github-dark',
    });
    processedBody = processedBody.replace(match[0], highlighted);
  } catch {
    // If language not supported, leave as-is
  }
}
---

<BaseLayout title={post.title}>
  <article class="post">
    {post.cover_image && (
      <img src={post.cover_image} alt={post.title} class="post-cover" />
    )}

    <header class="post-header">
      <h1>{post.title}</h1>
      <div class="post-meta meta">
        <span>By <a href={`/@${post.author}`} class="post-author-link">{post.author}</a></span>
        <span>&middot;</span>
        <span>{formatDate(post.published_at || post.created_at)}</span>
        <span>&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      {post.tags && post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map((tag: any) => (
            <a href={`/?tag=${tag.slug}`} class="tag">{tag.name}</a>
          ))}
        </div>
      )}
      {canEdit && (
        <div class="post-actions">
          <a href={`/write?edit=${post.slug}`} class="btn">Edit post</a>
        </div>
      )}
    </header>

    <div class="post-body" set:html={processedBody} />

    {post.status === 'draft' && (
      <div class="draft-banner">This post is a draft and is only visible to you.</div>
    )}

    {post.citations && post.citations.length > 0 && (
      <aside class="references" aria-label="References">
        <h2>References</h2>
        <ol class="references-list">
          {post.citations.map((c: any) => (
            <li id={`ref-${c.id}`}>
              {c.url
                ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.title || c.url}</a>
                : c.title}
            </li>
          ))}
        </ol>
      </aside>
    )}
  </article>

  <script type="application/json" id="post-citations" set:text={JSON.stringify(post.citations || [])} />

  <script>
    const citationsData = JSON.parse(
      document.getElementById('post-citations')?.textContent || '[]'
    );
    const citationsMap: Record<string, { id: number; title: string; url: string }> =
      Object.fromEntries(citationsData.map((c: any) => [String(c.id), c]));

    document.querySelectorAll<HTMLElement>('.post-body sup[data-citation]').forEach((sup) => {
      const id = sup.getAttribute('data-citation');
      if (!id) return;
      const citation = citationsMap[id];
      if (!citation) return;

      const popover = document.createElement('span');
      popover.className = 'citation-popover';
      popover.setAttribute('role', 'tooltip');
      if (citation.url) {
        const link = document.createElement('a');
        link.href = citation.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = citation.title || citation.url;
        popover.appendChild(link);
      } else {
        popover.textContent = citation.title;
      }

      sup.style.position = 'relative';
      sup.setAttribute('tabindex', '0');
      sup.appendChild(popover);

      sup.addEventListener('mouseenter', () => popover.classList.add('visible'));
      sup.addEventListener('mouseleave', () => popover.classList.remove('visible'));
      sup.addEventListener('focus', () => popover.classList.add('visible'));
      sup.addEventListener('blur', () => popover.classList.remove('visible'));
    });
  </script>

  <hr />

  <section class="comments-section">
    <h2>Comments ({post.comments?.length || 0})</h2>
    <CommentSection
      client:visible
      postSlug={slug!}
      initialComments={post.comments || []}
      currentUser={user}
      postAuthorId={post.author_id}
    />
  </section>
</BaseLayout>

<style>
  .post-cover {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 1.5rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .post-author-link {
    color: inherit;
    font-weight: 600;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-actions {
    margin-top: 0.9rem;
  }

  .post-body {
    line-height: 1.8;
  }

  .post-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.25rem;
  }

  .post-body :global(blockquote) {
    margin: 1.5rem 0;
  }

  .post-body :global(pre) {
    margin: 1.5rem 0;
  }

  .draft-banner {
    background: #fef3c7;
    color: #92400e;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .post-body :global(sup.citation-mark) {
    font-family: var(--font-ui);
    font-size: 0.7em;
    color: var(--color-accent);
    cursor: pointer;
  }

  :global(.citation-popover) {
    display: none;
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 400;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    width: max-content;
    max-width: 280px;
    white-space: normal;
    z-index: 50;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  :global(.citation-popover.visible) {
    display: block;
  }

  :global(.citation-popover a) {
    color: #fde68a;
    text-decoration: underline;
  }

  .references {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .references h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .references-list {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--color-text-muted);
  }

  .comments-section {
    margin-top: 2rem;
  }

  .comments-section h2 {
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.75rem;
    }
  }
</style>
