---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { serverFetch } from '../lib/api';

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const tag = Astro.url.searchParams.get('tag') || '';
const q = (Astro.url.searchParams.get('q') || '').trim();

const queryParams = new URLSearchParams({
  page: String(page),
  limit: '10',
});

if (tag) queryParams.set('tag', tag);
if (q) queryParams.set('q', q);

const queryString = `?${queryParams.toString()}`;

const clearSearchHref = tag ? `/?tag=${encodeURIComponent(tag)}` : '/';
const clearTagHref = q ? `/?q=${encodeURIComponent(q)}` : '/';

function pageHref(nextPage: number) {
  const params = new URLSearchParams({ page: String(nextPage) });
  if (tag) params.set('tag', tag);
  if (q) params.set('q', q);
  return `/?${params.toString()}`;
}

let posts: any[] = [];
let pagination = { page: 1, limit: 10, total: 0, totalPages: 1 };

try {
  const res = await serverFetch(`/posts${queryString}`);
  if (res.ok) {
    const data = await res.json();
    posts = data.posts;
    pagination = data.pagination;
  }
} catch {}
---

<BaseLayout title="Blog">
  {(tag || q) && (
    <div class="filter-bar">
      <div class="filter-summary">
        {tag && <span>Tag: <strong>{tag}</strong></span>}
        {q && <span>Search: <strong>{q}</strong></span>}
      </div>
      <div class="filter-actions">
        {q && <a href={clearSearchHref}>Clear search</a>}
        {tag && <a href={clearTagHref}>Clear tag</a>}
        {(q && tag) && <a href="/">Clear all</a>}
      </div>
    </div>
  )}

  {posts.length === 0 ? (
    <div class="empty-state">
      {q
        ? <p>No posts found for "{q}".</p>
        : <p>No posts yet.</p>}
    </div>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug}
          excerpt={post.excerpt}
          cover_image={post.cover_image}
          author={post.author}
          published_at={post.published_at}
          tags={post.tags}
          comment_count={post.comment_count}
        />
      ))}
    </div>
  )}

  {pagination.totalPages > 1 && (
    <nav class="pagination">
      {pagination.page > 1 && (
        <a href={pageHref(pagination.page - 1)} class="btn">
          Previous
        </a>
      )}
      <span class="pagination-info">
        Page {pagination.page} of {pagination.totalPages}
      </span>
      {pagination.page < pagination.totalPages && (
        <a href={pageHref(pagination.page + 1)} class="btn">
          Next
        </a>
      )}
    </nav>
  )}
</BaseLayout>

<style>
  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    background: var(--color-banner-bg);
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .filter-summary {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .filter-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-muted);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    font-family: var(--font-ui);
  }

  .pagination-info {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

</style>
