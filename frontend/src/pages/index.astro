---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { serverFetch } from '../lib/api';

const tag = Astro.url.searchParams.get('tag') || '';
const q = (Astro.url.searchParams.get('q') || '').trim();

const queryParams = new URLSearchParams({ page: '1', limit: '10' });
if (tag) queryParams.set('tag', tag);
if (q) queryParams.set('q', q);

const clearSearchHref = tag ? `/?tag=${encodeURIComponent(tag)}` : '/';
const clearTagHref = q ? `/?q=${encodeURIComponent(q)}` : '/';

let posts: any[] = [];
let pagination = { page: 1, limit: 10, total: 0, totalPages: 1 };

try {
  const res = await serverFetch(`/posts?${queryParams.toString()}`);
  if (res.ok) {
    const data = await res.json();
    posts = data.posts;
    pagination = data.pagination;
  }
} catch {}
---

<BaseLayout title="Blog">
  {(tag || q) && (
    <div class="filter-bar">
      <div class="filter-summary">
        {tag && <span>Tag: <strong>{tag}</strong></span>}
        {q && <span>Search: <strong>{q}</strong></span>}
      </div>
      <div class="filter-actions">
        {q && <a href={clearSearchHref}>Clear search</a>}
        {tag && <a href={clearTagHref}>Clear tag</a>}
        {(q && tag) && <a href="/">Clear all</a>}
      </div>
    </div>
  )}

  {posts.length === 0 ? (
    <div class="empty-state">
      {q
        ? <p>No posts found for "{q}".</p>
        : <p>No posts yet.</p>}
    </div>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug}
          excerpt={post.excerpt}
          cover_image={post.cover_image}
          author={post.author}
          published_at={post.published_at}
          tags={post.tags}
          comment_count={post.comment_count}
        />
      ))}
    </div>
  )}

  {pagination.totalPages > 1 && (
    <div id="scroll-sentinel" class="scroll-sentinel">
      <span class="scroll-loader">Loading more posts...</span>
    </div>
  )}
</BaseLayout>

<script define:vars={{ currentPage: pagination.page, totalPages: pagination.totalPages, tag, q }}>
  (function() {
    if (totalPages <= 1) return;

    let nextPage = currentPage + 1;
    let loading = false;
    const sentinel = document.getElementById('scroll-sentinel');
    const postList = document.querySelector('.post-list');
    if (!sentinel || !postList) return;

    function formatDate(dateString) {
      return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric', month: 'long', day: 'numeric',
      });
    }

    function estimateReadingTime(excerpt) {
      return Math.max(1, Math.ceil((excerpt?.length || 0) / 50));
    }

    function createPostCard(post) {
      const article = document.createElement('article');
      article.className = 'post-card';

      let html = '';
      if (post.cover_image) {
        html += `<a href="/posts/${post.slug}" class="post-card-image"><img src="${post.cover_image}" alt="${post.title}" loading="lazy" /></a>`;
      }
      html += '<div class="post-card-content">';
      html += `<h2 class="post-card-title"><a href="/posts/${post.slug}">${post.title}</a></h2>`;
      if (post.excerpt) {
        html += `<p class="post-card-excerpt">${post.excerpt}</p>`;
      }
      html += '<div class="post-card-meta">';
      html += `<a href="/@${post.author}" class="author-link">${post.author}</a>`;
      html += `<span>&middot;</span><span>${formatDate(post.published_at)}</span>`;
      html += `<span>&middot;</span><span>${estimateReadingTime(post.excerpt)} min read</span>`;
      if (post.comment_count > 0) {
        html += `<span>&middot;</span><span>${post.comment_count} comment${post.comment_count !== 1 ? 's' : ''}</span>`;
      }
      html += '</div>';
      if (post.tags && post.tags.length > 0) {
        html += '<div class="post-card-tags">';
        post.tags.forEach(t => {
          html += `<a href="/?tag=${t.slug}" class="tag">${t.name}</a>`;
        });
        html += '</div>';
      }
      html += '</div>';
      article.innerHTML = html;
      return article;
    }

    async function loadMore() {
      if (loading || nextPage > totalPages) {
        if (nextPage > totalPages) sentinel.style.display = 'none';
        return;
      }
      loading = true;

      const params = new URLSearchParams({ page: String(nextPage), limit: '10' });
      if (tag) params.set('tag', tag);
      if (q) params.set('q', q);

      try {
        const res = await fetch('/api/posts?' + params.toString(), { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        data.posts.forEach(post => postList.appendChild(createPostCard(post)));
        nextPage++;
        if (nextPage > totalPages) sentinel.style.display = 'none';
      } catch {} finally {
        loading = false;
      }
    }

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) loadMore();
    }, { rootMargin: '200px' });
    observer.observe(sentinel);
  })();
</script>

<style>
  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    background: var(--color-banner-bg);
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .filter-summary {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .filter-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-muted);
  }

  .scroll-sentinel {
    text-align: center;
    padding: 2rem 1rem;
  }

  .scroll-loader {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

</style>
