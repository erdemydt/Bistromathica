---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEditor from '../components/Editor';
import { serverFetch } from '../lib/api';

const cookie = Astro.request.headers.get('cookie') || '';

// Auth check
let user = null;
try {
  const authRes = await serverFetch('/auth/me', cookie);
  if (authRes.ok) {
    user = await authRes.json();
  }
} catch {}

if (!user || !user.approved) {
  return Astro.redirect('/login');
}

// If editing an existing post
const editSlug = Astro.url.searchParams.get('edit');
let postData = undefined;

if (editSlug) {
  try {
    const postRes = await serverFetch(`/posts/${editSlug}`, cookie);
    if (postRes.ok) {
      postData = await postRes.json();
    }
  } catch {}

  if (!postData) {
    return Astro.redirect('/drafts');
  }
}
---

<BaseLayout title={editSlug ? 'Edit Post' : 'Write'}>
  <h1>{editSlug ? 'Edit Post' : 'New Post'}</h1>
  <PostEditor client:load initialData={postData} />
</BaseLayout>

<style is:global>
  .editor-container {
    margin-top: 1rem;
  }

  .edit-mode-banner {
    margin-bottom: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fef3c7;
    color: #92400e;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
  }

  .toolbar-btn {
    padding: 0.35rem 0.6rem;
    font-size: 0.8rem;
    border: none;
    background: transparent;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-ui);
  }

  .toolbar-btn:hover {
    background: #f5f5f4;
  }

  .toolbar-btn.active {
    background: #e7e5e4;
    color: var(--color-accent);
  }

  .toolbar-divider {
    width: 1px;
    background: var(--color-border);
    margin: 0 0.25rem;
    align-self: stretch;
  }

  .editor-content {
    border: 1px solid var(--color-border);
    border-radius: 0 0 8px 8px;
    min-height: 400px;
  }

  .editor-content .tiptap {
    padding: 1rem;
    min-height: 400px;
    outline: none;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
  }

  .editor-content .tiptap p {
    margin-bottom: 0.75rem;
  }

  .editor-content .tiptap pre {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 1rem;
    border-radius: 6px;
    font-family: var(--font-code);
    font-size: 0.875rem;
    overflow-x: auto;
    margin: 0.75rem 0;
  }

  .editor-content .tiptap code {
    font-family: var(--font-code);
  }

  .editor-content .tiptap blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-muted);
    margin: 0.75rem 0;
  }

  .editor-fields {
    margin-top: 1.5rem;
  }

  .editor-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    justify-content: flex-end;
  }

  .citation-tray {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .citation-tray-title {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .citation-row {
    display: grid;
    grid-template-columns: 2rem 1fr 1fr;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .citation-index {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .editor-content .tiptap sup.citation-mark {
    color: var(--color-accent);
    font-size: 0.7em;
    cursor: default;
  }

  .leave-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(28, 25, 23, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 1rem;
  }

  .leave-modal {
    width: 100%;
    max-width: 420px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .leave-modal h2 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .leave-modal-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
  }
</style>
