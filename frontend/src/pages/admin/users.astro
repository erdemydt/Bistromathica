---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serverFetch } from '../../lib/api';
import { formatDate } from '../../lib/utils';

const cookie = Astro.request.headers.get('cookie') || '';

let user = null;
try {
  const authRes = await serverFetch('/auth/me', cookie);
  if (authRes.ok) {
    user = await authRes.json();
  }
} catch {}

if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

let users: any[] = [];
try {
  const res = await serverFetch('/admin/users', cookie);
  if (res.ok) {
    const data = await res.json();
    users = data.users;
  }
} catch {}
---

<BaseLayout title="Admin - Users">
  <h1>User Management</h1>

  <nav class="admin-nav">
    <a href="/admin">Pending Approvals</a>
    <a href="/admin/users" class="active">Users</a>
    <a href="/admin/posts">Posts</a>
    <a href="/admin/comments">Comments</a>
  </nav>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Username</th>
          <th>Email</th>
          <th>Role</th>
          <th>Joined</th>
          <th>Posts</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {users.map((u) => (
          <tr>
            <td>{u.username}</td>
            <td>{u.email}</td>
            <td>
              <select class="role-select" data-id={u.id} data-current={u.role}>
                <option value="user" selected={u.role === 'user'}>User</option>
                <option value="admin" selected={u.role === 'admin'}>Admin</option>
              </select>
            </td>
            <td>{formatDate(u.created_at)}</td>
            <td>{u.post_count}</td>
            <td>
              <button class="btn btn-danger btn-sm delete-user-btn" data-id={u.id}>Delete</button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>

<script>
  const API = 'http://localhost:3001/api';

  document.querySelectorAll('.role-select').forEach((select) => {
    select.addEventListener('change', async (e) => {
      const el = e.target as HTMLSelectElement;
      const id = el.dataset.id;
      const role = el.value;
      const res = await fetch(`${API}/admin/users/${id}/role`, {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role }),
      });
      if (!res.ok) {
        alert('Failed to update role');
        el.value = el.dataset.current!;
      } else {
        el.dataset.current = role;
      }
    });
  });

  document.querySelectorAll('.delete-user-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      if (!confirm('Delete this user and all their content?')) return;
      const res = await fetch(`${API}/admin/users/${id}`, {
        method: 'DELETE',
        credentials: 'include',
      });
      if (res.ok) window.location.reload();
    });
  });
</script>

<style>
  .admin-nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .admin-nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    padding: 0.25rem 0;
  }

  .admin-nav a.active,
  .admin-nav a:hover {
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  th, td {
    text-align: left;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role-select {
    width: auto;
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
  }

  .btn-sm {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
  }
</style>
