---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serverFetch } from '../../lib/api';
import { formatDate } from '../../lib/utils';

const cookie = Astro.request.headers.get('cookie') || '';

let user = null;
try {
  const authRes = await serverFetch('/auth/me', cookie);
  if (authRes.ok) {
    user = await authRes.json();
  }
} catch {}

if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

let pendingUsers: any[] = [];
try {
  const res = await serverFetch('/admin/pending-users', cookie);
  if (res.ok) {
    const data = await res.json();
    pendingUsers = data.users;
  }
} catch {}
---

<BaseLayout title="Admin Dashboard">
  <h1>Admin Dashboard</h1>

  <nav class="admin-nav">
    <a href="/admin" class="active">Pending Approvals</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/posts">Posts</a>
    <a href="/admin/comments">Comments</a>
  </nav>

  <h2>Pending User Approvals ({pendingUsers.length})</h2>

  {pendingUsers.length === 0 ? (
    <p class="meta">No pending approvals.</p>
  ) : (
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Registered</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {pendingUsers.map((u) => (
            <tr data-user-id={u.id}>
              <td>{u.username}</td>
              <td>{u.email}</td>
              <td>{formatDate(u.created_at)}</td>
              <td>
                <button class="btn btn-primary btn-sm approve-btn" data-id={u.id}>Approve</button>
                <button class="btn btn-danger btn-sm reject-btn" data-id={u.id}>Reject</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</BaseLayout>

<script>
  const API = 'http://localhost:3001/api';

  document.querySelectorAll('.approve-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`${API}/admin/users/${id}/approve`, {
        method: 'PUT',
        credentials: 'include',
      });
      if (res.ok) window.location.reload();
    });
  });

  document.querySelectorAll('.reject-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      if (!confirm('Reject and delete this user?')) return;
      const res = await fetch(`${API}/admin/users/${id}`, {
        method: 'DELETE',
        credentials: 'include',
      });
      if (res.ok) window.location.reload();
    });
  });
</script>

<style>
  .admin-nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .admin-nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    padding: 0.25rem 0;
  }

  .admin-nav a.active,
  .admin-nav a:hover {
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  th, td {
    text-align: left;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-sm {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
  }

  td button + button {
    margin-left: 0.25rem;
  }
</style>
