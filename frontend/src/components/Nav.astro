---
interface Props {
  user: {
    id: string;
    username: string;
    email: string;
    role: string;
    approved: boolean;
  } | null;
}

const { user } = Astro.props;
---

<nav>
  <div class="nav-inner">
    <div class="nav-branding">
      <a href="/" class="nav-logo">Bistromathica</a>
      <div class="nav-tagline">#neverforgetepsteinfiles</div>
    </div>
      <form class="nav-search" method="GET" action="/">
        <label for="nav-search-input" class="sr-only">Search posts</label>
        <input
          id="nav-search-input"
          type="search"
          name="q"
          placeholder="Search..."
          autocomplete="off"
        />
        <button type="submit" class="nav-search-btn" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
      <button class="nav-search-toggle" aria-label="Toggle search" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <div class="nav-links">
        {user && user.approved && (
          <a href="/write">Write</a>
        )}
        {user && (
          <a href="/drafts">Drafts</a>
        )}
        {user && user.role === 'admin' && (
          <a href="/admin">Admin</a>
        )}
        {user ? (
          <>
            <a href={`/@${user.username}`} class="nav-user">{user.username}</a>
            <button id="logout-btn" class="btn">Logout</button>
          </>
        ) : (
          <>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
          </>
        )}
      </div>
    </div>
</nav>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'include',
      });
      window.location.href = '/';
    });
  }

  const searchToggle = document.querySelector('.nav-search-toggle');
  const navSearch = document.querySelector('.nav-search');
  if (searchToggle && navSearch) {
    searchToggle.addEventListener('click', () => {
      navSearch.classList.toggle('nav-search--expanded');
      if (navSearch.classList.contains('nav-search--expanded')) {
        navSearch.querySelector('input')?.focus();
      }
    });
  }
</script>

<style>
  nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-branding {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .nav-logo {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-logo:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-tagline {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.5px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .nav-links a {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-user {
    color: var(--color-text);
    font-weight: 600;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav-search {
    display: flex;
    align-items: center;
    flex: 0 1 220px;
  }

  .nav-search input[type='search'] {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 6px 0 0 6px;
    background: var(--color-surface);
    color: var(--color-text);
    width: 100%;
    min-width: 0;
  }

  .nav-search input[type='search']:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    border-color: var(--color-accent);
  }

  .nav-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: none;
    border-radius: 0 6px 6px 0;
    padding: 0.35rem 0.5rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .nav-search-btn:hover {
    color: var(--color-accent);
    background: #f5f5f4;
  }

  .nav-search-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.35rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .nav-search-toggle:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .nav-inner {
      flex-wrap: wrap;
    }
    .nav-links {
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .nav-search {
      display: none;
      flex: 1 1 100%;
      order: 10;
    }
    .nav-search--expanded {
      display: flex;
    }
    .nav-search-toggle {
      display: flex;
    }
  }
</style>
