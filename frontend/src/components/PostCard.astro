---
import { formatDate, calculateReadingTime } from '../lib/utils';

interface Props {
  title: string;
  slug: string;
  excerpt: string;
  cover_image?: string;
  author: string;
  published_at: string;
  tags: { name: string; slug: string }[];
  comment_count: number;
  body?: string;
}

const { title, slug, excerpt, cover_image, author, published_at, tags, comment_count, body } = Astro.props;

const readingTime = body ? calculateReadingTime(body) : Math.max(1, Math.ceil((excerpt?.length || 0) / 50));
---

<article class="post-card">
  {cover_image && (
    <a href={`/posts/${slug}`} class="post-card-image">
      <img src={cover_image} alt={title} loading="lazy" />
    </a>
  )}
  <div class="post-card-content">
    <h2 class="post-card-title">
      <a href={`/posts/${slug}`}>{title}</a>
    </h2>
    {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
    <div class="post-card-meta">
      <span>{author}</span>
      <span>&middot;</span>
      <span>{formatDate(published_at)}</span>
      <span>&middot;</span>
      <span>{readingTime} min read</span>
      {comment_count > 0 && (
        <>
          <span>&middot;</span>
          <span>{comment_count} comment{comment_count !== 1 ? 's' : ''}</span>
        </>
      )}
    </div>
    {tags && tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map((tag) => (
          <a href={`/?tag=${tag.slug}`} class="tag">{tag.name}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    transition: box-shadow 0.15s;
  }

  .post-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .post-card-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .post-card-content {
    padding: 1.25rem;
  }

  .post-card-title {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
  }

  .post-card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-card-title a:hover {
    color: var(--color-accent);
  }

  .post-card-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
