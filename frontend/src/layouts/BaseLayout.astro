---
import Nav from '../components/Nav.astro';
import { serverFetch } from '../lib/api';

const cookie = Astro.request.headers.get('cookie') || '';
let user = null;

try {
  const res = await serverFetch('/auth/me', cookie);
  if (res.ok) {
    user = await res.json();
  }
} catch {}

interface Props {
  title?: string;
}

const { title = 'Blog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav user={user} />
    <main>
      <slot />
    </main>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      .tiptap p.is-editor-empty:first-child::before {
  content: attr(data-placeholder);
  color: #aaa;
  pointer-events: none;
  float: left;
  height: 0;
}
      :root {
        --font-body: 'Lora', Georgia, serif;
        --font-ui: 'DM Sans', system-ui, sans-serif;
        --font-code: 'JetBrains Mono', monospace;
        --max-width: 720px;
        --color-bg: #fafaf9;
        --color-text: #1c1917;
        --color-text-muted: #78716c;
        --color-border: #e7e5e4;
        --color-accent: #b45309;
        --color-accent-hover: #92400e;
        --color-surface: #ffffff;
        --color-danger: #dc2626;
      }

      body {
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.75;
        color: var(--color-text);
        background: var(--color-bg);
        -webkit-font-smoothing: antialiased;
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        color: var(--color-accent-hover);
        text-decoration: underline;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-body);
        font-weight: 600;
        line-height: 1.3;
      }

      h1 { font-size: 2.25rem; margin-bottom: 1rem; }
      h2 { font-size: 1.75rem; margin-bottom: 0.75rem; }
      h3 { font-size: 1.375rem; margin-bottom: 0.5rem; }

      pre, code {
        font-family: var(--font-code);
      }

      pre {
        background: #1e1e1e;
        color: #d4d4d4;
        padding: 1.25rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.875rem;
        line-height: 1.6;
        margin: 1.5rem 0;
      }

      code:not(pre code) {
        background: #f5f5f4;
        padding: 0.15em 0.4em;
        border-radius: 4px;
        font-size: 0.875em;
      }

      blockquote {
        border-left: 3px solid var(--color-accent);
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: var(--color-text-muted);
        font-style: italic;
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
      }

      hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 2rem 0;
      }

      /* UI elements */
      button, .btn {
        font-family: var(--font-ui);
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        cursor: pointer;
        transition: all 0.15s;
      }

      button:hover, .btn:hover {
        background: #f5f5f4;
      }

      .btn-primary {
        background: var(--color-accent);
        color: white;
        border-color: var(--color-accent);
      }

      .btn-primary:hover {
        background: var(--color-accent-hover);
        border-color: var(--color-accent-hover);
      }

      .btn-danger {
        background: var(--color-danger);
        color: white;
        border-color: var(--color-danger);
      }

      .btn-danger:hover {
        background: #b91c1c;
        border-color: #b91c1c;
      }

      input, textarea, select {
        font-family: var(--font-ui);
        font-size: 1rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        background: var(--color-surface);
        color: var(--color-text);
        width: 100%;
      }

      input:focus, textarea:focus, select:focus {
        outline: 2px solid var(--color-accent);
        outline-offset: -1px;
        border-color: var(--color-accent);
      }

      label {
        font-family: var(--font-ui);
        font-size: 0.875rem;
        font-weight: 500;
        display: block;
        margin-bottom: 0.25rem;
      }

      .form-group {
        margin-bottom: 1rem;
      }

      .error-text {
        color: var(--color-danger);
        font-family: var(--font-ui);
        font-size: 0.875rem;
        margin-top: 0.25rem;
      }

      .success-text {
        color: #16a34a;
        font-family: var(--font-ui);
        font-size: 0.875rem;
        margin-top: 0.25rem;
      }

      .meta {
        font-family: var(--font-ui);
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      .tag {
        display: inline-block;
        font-family: var(--font-ui);
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.2rem 0.6rem;
        background: #fef3c7;
        color: #92400e;
        border-radius: 999px;
        text-decoration: none;
      }

      .tag:hover {
        background: #fde68a;
        text-decoration: none;
      }

      /* Comment section styles (React island) */
      .comment-section {
        margin-top: 1rem;
      }

      .comment-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .comment {
        padding: 1rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
      }

      .comment-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-ui);
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
      }

      .comment-header strong {
        color: var(--color-text);
      }

      .comment-date {
        color: var(--color-text-muted);
      }

      .comment-edited {
        color: var(--color-text-muted);
        font-style: italic;
      }

      .comment-body {
        font-size: 0.95rem;
        line-height: 1.6;
        white-space: pre-wrap;
      }

      .comment-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
      }

      .comment-action-btn {
        background: none;
        border: none;
        font-family: var(--font-ui);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 0;
      }

      .comment-action-btn:hover {
        color: var(--color-accent);
      }

      .comment-action-btn.danger:hover {
        color: var(--color-danger);
      }

      .comment-edit {
        margin-top: 0.5rem;
      }

      .comment-edit textarea {
        margin-bottom: 0.5rem;
      }

      .comment-edit-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        justify-content: flex-end;
      }

      .comment-form {
        margin-top: 1rem;
      }

      .comment-form textarea {
        margin-bottom: 0.5rem;
      }

      .comment-form-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
      }

      @media (max-width: 640px) {
        body {
          font-size: 16px;
        }
        main {
          padding: 1rem;
        }
        h1 { font-size: 1.75rem; }
        h2 { font-size: 1.5rem; }
      }
    </style>
  </body>
</html>
